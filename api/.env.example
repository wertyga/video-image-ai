# Длинный случайный токен: openssl rand -hex 32. Клиент шлёт его в заголовке Authorization: Bearer <токен>
API_TOKEN=
# Порт API (его открываем наружу в шаблоне vast)
PORT=8000
# Где слушает ComfyUI (только localhost, наружу не открывать)
COMFY_URL=http://127.0.0.1:8189
# server (int8, 48 ГБ) или server_bf16 (80 ГБ): какой профиль скачан setup.sh
COMFY_PROFILE=server
# Профиль картинок Qwen (setup.sh server → server, local-16gb → local)
COMFY_IMAGE_PROFILE=server
# Где хранить персонажей (по умолчанию api/data)
DATA_DIR=
